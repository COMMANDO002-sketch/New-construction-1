# --- Server ---
PORT=4000
DATABASE_URL=postgres://postgres:password@localhost:5432/clasptek_portal
# Set to true for hosted databases (Supabase, Neon, Render, Railway)
PGSSL=false

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Frontend ---
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Paystack (https://dashboard.paystack.com/#/settings/keys) ---
# Use TEST keys first (sk_test_... / pk_test_...). Swap for sk_live_ / pk_live_
# only after your Paystack account is approved for live transactions.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# --- Termii SMS (https://console.termii.com) — optional until configured ---
TERMII_API_KEY=
TERMII_SENDER_ID=CLASPTEK

# --- Seed admin (used by `npm run seed` only) ---
ADMIN_NAME=CDA Administrator
ADMIN_PHONE=08000000000
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@clasptek.com
